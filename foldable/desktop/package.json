{
  "name": "spaider-foldable-desktop",
  "productName": "SpAIder",
  "version": "0.2.0",
  "description": "SpAIder Foldable - portable, vollständig lokale Chat-App (Electron-Shell und React-Oberfläche)",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "dist/main/index.js",
  "author": "SpAIder",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite --strictPort\" \"node scripts/dev-electron.mjs\"",
    "dev:mock": "concurrently -k -n mock,vite,electron -c yellow,cyan,magenta \"node mock/server.mjs --port 8765 --token mock-token\" \"vite --strictPort\" \"node scripts/dev-electron.mjs --mock\"",
    "mock": "node mock/server.mjs --port 8765 --token mock-token",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron . --app-root=dev-data",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "icon": "node scripts/make-icon.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-toast": "1.3.1",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "electron": "45.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
