<clickhouse>
    <!--
      ClickHouse writes its own diagnostics to system.* tables and never deletes them. On a stack that
      runs for weeks they outgrow the audit data by thousands of times: about 0.5 GB a day, 6.3 GB of
      a 6.9 GB volume after 13 days, against about 1 MB of audit rows. A table's TTL removes the old
      rows. Three days is plenty to look at what just happened; the busy logs get the short time, the
      small ones keep two weeks.

      Only logs that are on by default are listed. Naming a log that is off here would switch it on.
    -->
    <text_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </text_log>
    <trace_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </trace_log>
    <metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <query_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </part_log>
    <processors_profile_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </processors_profile_log>
    <error_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </error_log>
</clickhouse>
